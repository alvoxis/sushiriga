# SUSHIRIGA backend (server/) — SERVER-ONLY settings. Never prefix these with VITE_:
# nothing here is ever sent to the browser.
# Load with e.g. `node --env-file=server/.env dist-server/main.js` or your host's env settings.

NODE_ENV=production
HOST=0.0.0.0
PORT=8787

# SQLite database file (created on first start, migrations run automatically). Back it up.
DATABASE_PATH=./data/sushiriga.db

# REQUIRED in production: HMAC key for guest order links (≥ 32 random characters).
# Generate: openssl rand -base64 48 — changing it invalidates existing order status links.
ORDER_TOKEN_SECRET=

# Built frontend to serve (npm run build with VITE_API_URL=/). Empty = API only.
PUBLIC_DIR=./dist

# Extra browser origins allowed to call the API (comma separated). Not needed when this server
# also serves the frontend (same origin).
CORS_ORIGINS=

# Set to 1 only behind ONE trusted reverse proxy (nginx, Caddy, a PaaS router) so rate limits
# use the real client IP from X-Forwarded-For.
TRUST_PROXY=0

# ---------- Online payment (Stripe) — all three or none ----------
# Without them the site works, but orders stay "awaiting payment" (no payment form is shown).
# Dashboard → Developers → API keys. Use TEST keys (sk_test_/pk_test_) until launch.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Dashboard → Developers → Webhooks → endpoint https://<your-domain>/api/stripe/webhook
# with events payment_intent.succeeded, payment_intent.payment_failed,
# payment_intent.processing, payment_intent.canceled → "Signing secret".
STRIPE_WEBHOOK_SECRET=
