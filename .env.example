# SUSHIRIGA — frontend environment variables.
# Copy to `.env.local` and fill in. Everything prefixed with VITE_ is bundled
# into the PUBLIC frontend build: never put secret keys here.

# Where the SUSHIRIGA backend (server/) runs: "/" when the backend serves this frontend itself
# (recommended, see Dockerfile), or its origin, e.g. https://api.sushiriga.lv.
# Empty = demo mode: built-in mock services, nothing is sent anywhere.
VITE_API_URL=

# Payments (Stripe) are configured on the BACKEND only (server/.env.example): the server hands
# the publishable key to the browser at runtime. Never put a Stripe key here.

# Future authentication provider id (e.g. "supabase", "auth0", "custom"). Empty = guest-only.
VITE_AUTH_PROVIDER=

# Future AI provider id for the cat assistant ("mock" = local catalog-based assistant).
# The real AI API must be called from the backend, never directly with a key from the browser.
VITE_AI_PROVIDER=mock
